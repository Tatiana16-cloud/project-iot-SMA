{
  "version": 1,
  "author": "IoT Sleep Monitoring",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "ppg1", "top": -56, "left": -200, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 110, "left": 220, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r_led", "top": 170, "left": 220, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": -48, "left": 220, "attrs": {} }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["ppg1:VCC", "esp:3V3",   "red",   []],
    ["ppg1:GND", "esp:GND.1", "black", []],
    ["ppg1:SIG", "esp:34",    "green", []],

    ["esp:4",    "r_led:1",   "orange", []],
    ["r_led:2",  "led1:A",    "orange", []],
    ["led1:C",   "esp:GND.2", "black",  []],

    ["bz1:1",    "esp:5",     "blue",   []],
    ["bz1:2",    "esp:GND.3", "black",  []]
  ],
  "dependencies": {
    "libraries": [
      "knolleary/PubSubClient@^2.8",
      "bblanchon/ArduinoJson@^6.21.5"
    ]
  }
}
