    {
        "id": "input-userid",
        "type": "ui_template",
        "z": "tab-flow",
        "group": "ui-group-login",
        "name": "UserID field",
        "order": 3,
        "width": 0,
        "height": 0,
        "format": "<div layout=\"row\" layout-align=\"start center\" style=\"gap:6px;\">\n  <md-input-container flex>\n    <label>UserID</label>\n    <input ng-model=\"userID\" type=\"{{visible ? 'text' : 'password'}}\" placeholder=\"User1\">\n  </md-input-container>\n  <md-button class=\"md-icon-button\" ng-click=\"visible = !visible\" aria-label=\"Show/Hide\">\n    <span ng-if=\"!visible\">👁️</span>\n    <span ng-if=\"visible\">🙈</span>\n  </md-button>\n</div>\n<script>\n(function(scope){\n  scope.userID = \"\";\n  scope.visible = false;\n  scope.$watch('userID', function(val){\n    scope.send({payload: val, topic: 'userID'});\n  });\n  scope.$watch('msg', function(msg){\n    if(msg && msg.topic === 'clear'){\n      scope.userID = \"\";\n    }\n  });\n})(scope);\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "templateScope": "local",
        "x": 1010,
        "y": 320,
        "wires": [
            [
                "store-userid"
            ]
        ]
    },
    {
        "id": "store-userid",
        "type": "change",
        "z": "tab-flow",
        "name": "save userID",
        "rules": [
            {
                "t": "set",
                "p": "login_userID",
                "pt": "flow",
                "to": "payload",
                "tot": "msg"
            }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 1190,
        "y": 320,
        "wires": [
            []
        ]
    },
    {
        "id": "input-phone",
        "type": "ui_template",
        "z": "tab-flow",
        "group": "ui-group-login",
        "name": "Phone field",
        "order": 4,
        "width": 0,
        "height": 0,
        "format": "<div layout=\"row\" layout-align=\"start center\" style=\"gap:6px;\">\n  <md-input-container flex>\n    <label>Phone</label>\n    <input ng-model=\"phone\" type=\"{{visiblePhone ? 'text' : 'password'}}\" placeholder=\"+573001112233\">\n  </md-input-container>\n  <md-button class=\"md-icon-button\" ng-click=\"visiblePhone = !visiblePhone\" aria-label=\"Show/Hide\">\n    <span ng-if=\"!visiblePhone\">👁️</span>\n    <span ng-if=\"visiblePhone\">🙈</span>\n  </md-button>\n</div>\n<script>\n(function(scope){\n  scope.phone = \"\";\n  scope.visiblePhone = false;\n  scope.$watch('phone', function(val){\n    scope.send({payload: val, topic: 'phone'});\n  });\n  scope.$watch('msg', function(msg){\n    if(msg && msg.topic === 'clear'){\n      scope.phone = \"\";\n    }\n  });\n})(scope);\n</script>",
        "x": 1010,
        "y": 380,
        "wires": [
            [
                "store-phone"
            ]
        ]
    },
    {
        "id": "input-password",
        "type": "ui_template",
        "z": "tab-flow",
        "group": "ui-group-login",
        "name": "Password field",
        "order": 5,
        "width": 0,
        "height": 0,
        "format": "<div layout=\"row\" layout-align=\"start center\" style=\"gap:6px;\">\n  <md-input-container flex>\n    <label>Password</label>\n    <input ng-model=\"password\" type=\"password\" placeholder=\"******\">\n  </md-input-container>\n</div>\n<script>\n(function(scope){\n  scope.password = \"\";\n  scope.$watch('password', function(val){\n    scope.send({payload: val, topic: 'password'});\n  });\n  scope.$watch('msg', function(msg){\n    if(msg && msg.topic === 'clear'){\n      scope.password = \"\";\n    }\n  });\n})(scope);\n</script>",
        "x": 1000,
        "y": 440,
        "wires": [
            [
                "store-password"
            ]
        ]
    },
