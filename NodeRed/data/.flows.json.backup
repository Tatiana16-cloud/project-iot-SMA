        ]
    },
    {
        "id": "input-phone",
        "type": "ui_template",
        "z": "tab-flow",
        "group": "ui-group-login",
        "name": "Phone field",
        "order": 4,
        "width": 0,
        "height": 0,
        "format": "<div layout=\"row\" layout-align=\"start center\" style=\"gap:6px;\">\n  <md-input-container flex>\n    <label>Phone</label>\n    <input ng-model=\"phone\" type=\"{{visiblePhone ? 'text' : 'password'}}\" placeholder=\"+573001112233\">\n  </md-input-container>\n  <md-button class=\"md-icon-button\" ng-click=\"visiblePhone = !visiblePhone\" aria-label=\"Show/Hide\">\n    <span ng-if=\"!visiblePhone\">\ud83d\udc41\ufe0f</span>\n    <span ng-if=\"visiblePhone\">\ud83d\ude48</span>\n  </md-button>\n</div>\n<script>\n(function(scope){\n  scope.phone = \"\";\n  scope.visiblePhone = false;\n  scope.$watch('phone', function(val){\n    scope.send({payload: val, topic: 'phone'});\n  });\n  scope.$watch('msg', function(msg){\n    if(msg && msg.topic === 'clear'){\n      scope.phone = \"\";\n    }\n  });\n})(scope);\n</script>",
        "x": 220,
        "y": 215,
        "wires": [
            [
                "store-phone"
            ]
        ]
    },
    {
        "id": "input-password",
