        "id": "fetch-rooms",
        "type": "http request",
        "z": "tab-flow",
        "name": "GET /rooms",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://catalog:9080/rooms",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": false,
        "x": 1120,
        "y": 420,
        "wires": [
            [
                "filter-user-rooms"
            ]
        ]
    },
    {
        "id": "filter-user-rooms",
        "type": "function",
        "z": "tab-flow",
        "name": "Build room options",
        "func": "const userID = (flow.get('current_user_id') || '').trim();\nconst rooms = Array.isArray(msg.payload) ? msg.payload : [];\nconst mine = rooms.filter(r => (r.userID || '').trim() === userID);\n\nif (!mine.length) {\n    msg.options = ['(no rooms)'];\n    msg.payload = '';\n    return msg;\n}\n\nconst nameToId = {};\nconst opts = mine.map(r => {\n    const name = r.roomName || r.roomID;\n    nameToId[name] = r.roomID;\n    return name;\n});\nflow.set('room_name_to_id', nameToId);\nmsg.options = opts;\ndelete msg.payload;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1320,
        "y": 420,
        "wires": [
            [
                "ui-dropdown-rooms"
            ]
        ]
    },
