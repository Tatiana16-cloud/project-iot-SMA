    {
        "id": "fetch-rooms",
        "type": "http request",
        "z": "tab-flow",
        "name": "GET /rooms",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://catalog:9080/rooms",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": false,
        "x": 1590,
        "y": 260,
        "wires": [
            [
                "filter-user-rooms"
            ]
        ]
    },
    {
        "id": "filter-user-rooms",
        "type": "function",
        "z": "tab-flow",
        "name": "Build room options",
        "func": "const userID = (flow.get('current_user_id') || '').trim();\nconst rooms = Array.isArray(msg.payload) ? msg.payload : [];\nconst mine = rooms.filter(r => (r.userID || '').trim() === userID);\n\nif (!mine.length) {\n    msg.options = ['(no rooms)'];\n    msg.payload = '';\n    return msg;\n}\n\nconst nameToId = {};\nconst opts = mine.map(r => {\n    const name = r.roomName || r.roomID;\n    nameToId[name] = r.roomID;\n    return name;\n});\nflow.set('room_name_to_id', nameToId);\nmsg.options = opts;\ndelete msg.payload;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1810,
        "y": 260,
        "wires": [
            [
                "ui-dropdown-rooms"
            ]
        ]
    },
    {
        "id": "ui-dropdown-rooms",
        "type": "ui_dropdown",
        "z": "tab-flow",
        "name": "Room",
        "label": "Room:",
        "tooltip": "",
        "place": "Select a room",
        "group": "ui-group-roompicker",
        "order": 1,
        "width": 6,
        "height": 1,
        "passthru": false,
        "multiple": false,
        "options": [],
        "payload": "",
        "topic": "topic",
        "topicType": "msg",
        "className": "",
        "x": 1990,
        "y": 260,
        "wires": [
            [
                "save-room-selection"
            ]
        ]
    },
    {
        "id": "save-room-selection",
        "type": "function",
        "z": "tab-flow",
        "name": "Set current_room_id",
        "func": "const selected = (msg.payload || '').trim();\nif (!selected) {\n    return null;\n}\nconst nameToId = flow.get('room_name_to_id') || {};\nconst roomID = nameToId[selected] || selected;\nflow.set('current_room_id', roomID);\nnode.warn('room selected: ' + roomID);\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2180,
        "y": 260,
        "wires": [
            []
        ]
    },
