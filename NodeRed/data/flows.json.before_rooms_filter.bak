    {
        "id": "btn-login",
        "type": "ui_button",
        "z": "tab-flow",
        "name": "",
        "group": "ui-group-login",
        "order": 6,
        "width": 0,
        "height": 0,
        "passthru": false,
        "label": "Login",
        "tooltip": "",
        "color": "",
        "bgcolor": "",
        "className": "",
        "icon": "fa-sign-in",
        "payload": "login",
        "payloadType": "str",
        "topic": "",
        "x": 90,
        "y": 280,
        "wires": [
            [
                "prepare-login"
            ]
        ]
    },
    {
        "id": "prepare-login",
        "type": "function",
        "z": "tab-flow",
        "name": "Prepare request",
        "func": "const userID = flow.get('login_userID') || \"\";\nconst phone = flow.get('login_phone') || \"\";\nconst pwd = flow.get('login_password') || \"\";\n\n// Build the POST body — the catalog does the password validation\nmsg.payload = {\n    userID: userID.trim(),\n    phone: phone.trim(),\n    password: pwd.trim()\n};\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.url = \"http://catalog:9080/login\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 260,
        "y": 280,
        "wires": [
            [
                "get-catalog"
            ]
        ]
    },
    {
        "id": "get-catalog",
        "type": "http request",
        "z": "tab-flow",
        "name": "POST /login",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": false,
        "x": 450,
        "y": 280,
        "wires": [
            [
                "validate-login"
            ]
        ]
    },
    {
        "id": "validate-login",
        "type": "function",
        "z": "tab-flow",
        "name": "Validate user + phone + password",
        "func": "// The catalog validated the credentials; we only react to its answer.\n// Response shape:  { ok: bool, userID?: string, reason?: string }\nconst resp = (msg && msg.payload) || {};\nconst ok = resp.ok === true;\n\nif (!ok) {\n    return [\n        { payload: \"Data does not match\" },           // status text\n        null,                                          // no tab switch\n        { payload: \"\", topic: \"clear\" },              // clear userID\n        { payload: \"\", topic: \"clear\" },              // clear phone\n        { payload: \"\", topic: \"clear\" }               // clear password\n    ];\n}\n\nconst userID = (resp.userID || \"\").trim();\nflow.set('current_user_id', userID);\n\nreturn [\n    { payload: \"Access approved\" },                    // status text\n    { payload: { tab: \"Dashboard\" } },                 // switch to Dashboard tab\n    null, null, null\n];",
        "outputs": 5,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 280,
        "wires": [
            [
                "status-text",
                "status-delay",
                "fetch-rooms"
            ],
            [
                "ui-ui-control"
            ],
            [
                "input-userid"
            ],
            [
                "input-phone"
            ],
            [
                "input-password"
            ]
        ]
    },
