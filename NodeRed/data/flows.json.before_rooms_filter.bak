    {
        "id": "dash-welcome",
        "type": "ui_text",
        "z": "tab-flow",
        "group": "ui-group-dashboard",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "",
        "label": "<h3>Dashboard</h3>",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 230,
        "y": 360,
        "wires": []
    },
    {
        "id": "load-dashboard",
        "type": "function",
        "z": "tab-flow",
        "name": "Build stats request",
        "func": "const userID = (flow.get('current_user_id') || '').trim();\nconst roomID = (flow.get('current_room_id') || '').trim();\nif (!userID) {\n    node.warn('No current_user_id set');\n    return null;\n}\nif (!roomID) {\n    node.warn('No current_room_id set — user must pick a room before loading the dashboard');\n    return null;\n}\n\nmsg.method = 'GET';\nmsg.url = 'http://reports-generator:8093/?user_id=' + encodeURIComponent(userID) + '&room_id=' + encodeURIComponent(roomID);\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 580,
        "wires": [
            [
                "get-sleep-api"
            ]
        ]
    },
    {
        "id": "get-sleep-api",
        "type": "http request",
        "z": "tab-flow",
        "name": "GET sleep stats",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": false,
        "x": 980,
        "y": 580,
        "wires": [
            [
                "process-sleep-stats"
            ]
        ]
    },
    {
        "id": "process-sleep-stats",
        "type": "function",
        "z": "tab-flow",
        "name": "Process stats",
        "func": "const statusCode = msg.statusCode || 200;\nconst data = msg.payload || {};\n\nif (statusCode >= 400 || !data.stats || Object.keys(data.stats).length === 0) {\n    const noInfo = { payload: '<b>Information not found for this room.</b>' };\n    const clearChart = { payload: [] };\n    const blank = { payload: '' };\n    return [noInfo, clearChart, blank, clearChart, blank, clearChart, blank, blank, blank, blank, blank];\n}\n\nconst win = data.window || {};\nconst stats = data.stats || {};\nconst stages = data.stages_hours || {};\nconst quality = data.sleep_quality || {};\nconst tips = Array.isArray(data.tips) ? data.tips : [];\n\nfunction formatTime(iso){\n  if(!iso) return '';\n  const d = new Date(iso);\n  const opt = {hour: '2-digit', minute:'2-digit'};\n  try {\n    return d.toLocaleTimeString('en-GB', opt);\n  } catch(e) {\n    return d.toISOString();\n  }\n}\n\nconst startStr = formatTime(win.start);\nconst endStr = formatTime(win.end);\n\nlet durationText = '';\nif (win.start && win.end) {\n  const d1 = new Date(win.start);\n  const d2 = new Date(win.end);\n  const diffMs = d2 - d1;\n  const totalMin = diffMs / 60000;\n  const h = Math.floor(totalMin / 60);\n  const m = Math.round(totalMin % 60);\n  durationText = `${h} h ${m} min`;\n}\n\nconst msgSleepInfo = {\n  payload: `Bedtime: ${startStr}<br>Wake time: ${endStr}<br>Total sleep duration: ${durationText}`\n};\n\nfunction makeChart(name, arr){\n  const dataArr = Array.isArray(arr) ? arr : [];\n  return {\n    payload: [{\n      series: [name],\n      data: [dataArr],\n      labels: dataArr.map((_, i) => (i+1).toString())\n    }]\n  };\n}\n\nfunction fmtStat(v){\n  return typeof v === 'number' ? v.toFixed(2) : 'N/A';\n}\n\nconst bpm = stats.bpm || {};\nconst temp = stats.temperature || {};\nconst hum = stats.humidity || {};\n\nconst msgBpmChart = makeChart('BPM', bpm.data);\nconst msgBpmStats = {\n  payload: `Min: ${fmtStat(bpm.min)} | Max: ${fmtStat(bpm.max)} | Mean: ${fmtStat(bpm.mean)}`\n};\n\nconst msgTempChart = makeChart('Temperature', temp.data);\nconst msgTempStats = {\n  payload: `Min: ${fmtStat(temp.min)} | Max: ${fmtStat(temp.max)} | Mean: ${fmtStat(temp.mean)}`\n};\n\nconst msgHumChart = makeChart('Humidity', hum.data);\nconst msgHumStats = {\n  payload: `Min: ${fmtStat(hum.min)} | Max: ${fmtStat(hum.max)} | Mean: ${fmtStat(hum.mean)}`\n};\n\nconst led = stats.alarm_activations;\nconst msgLed = {\n  payload: `Alarm activations: ${led}`\n};\n\nconst msgStages = {\n  payload: `Deep sleep: ${stages.deep_h} h | Light sleep: ${stages.light_h} h | REM sleep: ${stages.rem_h} h`\n};\n\nconst msgScore = {\n  payload: `Sleep score: ${quality.score} - Meaning: ${quality.label}`\n};\n\nconst msgTips = {\n  payload: tips.length\n    ? `<br><br>Helpful tips:<br>- ${tips.join('<br>- ')}`\n    : '<br>Helpful tips:<br>- Not enough data to generate tips yet.'\n};\n\nreturn [\n  msgSleepInfo,\n  msgBpmChart,\n  msgBpmStats,\n  msgTempChart,\n  msgTempStats,\n  msgHumChart,\n  msgHumStats,\n  msgLed,\n  msgStages,\n  msgScore,\n  msgTips\n];",
        "outputs": 11,
        "timeout": "",
        "noerr": 6,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1180,
        "y": 580,
        "wires": [
            [
                "sleep-info"
            ],
            [
                "chart-bpm"
            ],
            [
                "text-bpm-stats"
            ],
            [
                "chart-temp"
            ],
            [
                "text-temp-stats"
            ],
            [
                "chart-hum"
            ],
            [
                "text-hum-stats"
            ],
            [
                "text-led"
            ],
            [
                "text-stages"
            ],
            [
                "text-score"
            ],
            [
                "text-tips"
            ]
        ]
    },
